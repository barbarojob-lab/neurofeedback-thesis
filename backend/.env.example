# Configuración de entorno — Backend neurofeedback

# Puerto del servidor HTTP + WebSocket
# Default: 8080
PORT=8080

# Modo de adquisición EEG
# "simulator" — usar simulador sintético (desarrollo/testing)
# "hardware"  — esperar conexión de dispositivo real (OpenBCI, Muse, etc.)
# Default: "simulator"
EEG_MODE=simulator

# Nivel de log (debug, info, warn, error)
# Default: "info"
LOG_LEVEL=info

# Base de datos de sesiones (SQLite path o URL de PostgreSQL)
# TODO: implementar persistencia de sesiones
# DATABASE_URL=sqlite:./sessions.db
