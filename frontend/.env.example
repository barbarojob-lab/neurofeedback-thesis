# Configuración de entorno — Frontend neurofeedback

# URL del server WebSocket
# En desarrollo: ws://localhost:8080
# En producción: ws://api.ejemplo.com:8080 o wss://api.ejemplo.com (secure)
VITE_WS_URL=ws://localhost:8080

# API de telemetría (opcional)
# VITE_TELEMETRY_URL=https://telemetry.example.com

# Debug verboso en consola (true/false)
# VITE_DEBUG=false
